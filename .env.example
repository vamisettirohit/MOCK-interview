# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=mock_interview_db

# Groq Cloud API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
